{
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data/documents.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/v4/dokumenter",
      "destination": "/boker",
      "permanent": true
    },
    {
      "source": "/v4",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v4/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/:year(\\d{4})/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/category/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tag/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/author/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/page/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/feed",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/feed/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/comments/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/utgivelser",
      "destination": "/om",
      "permanent": false
    },
    {
      "source": "/media",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-sitemap(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-content/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-includes/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-json/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/data/:m(20[01]\\d-\\d{2}|202[0-5]-\\d{2}).json",
      "destination": "https://trondw-assets.vercel.app/data/:m.json"
    },
    {
      "source": "/data/arkiv/:y(20[01]\\d|202[0-5]).json",
      "destination": "https://trondw-assets.vercel.app/data/arkiv/:y.json"
    },
    {
      "source": "/data/latest.json",
      "destination": "/api/data?f=latest"
    },
    {
      "source": "/data/meta.json",
      "destination": "/api/data?f=meta"
    },
    {
      "source": "/data/arkiv/years.json",
      "destination": "/api/data?f=years"
    },
    {
      "source": "/data/arkiv/:y(\\d{4}).json",
      "destination": "/api/data?f=arkiv&y=:y"
    },
    {
      "source": "/data/:m(\\d{4}-\\d{2}).json",
      "destination": "/api/data?f=month&m=:m"
    },
    {
      "source": "/kontakt",
      "destination": "/api/contact"
    },
    {
      "source": "/stott",
      "destination": "/api/stott"
    },
    {
      "source": "/admin",
      "destination": "/api/admin"
    }
  ],
  "ignoreCommand": "sh scripts/ignore-build.sh"
}
